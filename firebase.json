{
  "hosting": {
    "site": "asca-vehicle-check",
    "public": "firebase-public",
    "rewrites": [
      {
        "source": "**",
        "run": { "serviceId": "asca-vehicle-check", "region": "us-central1" }
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  }
}
