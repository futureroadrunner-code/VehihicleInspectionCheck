# Set these in Cloudflare: Workers & Pages → asca-vehicle-check → Settings →
# Variables and Secrets. For local `npm run preview`, put them in .dev.vars.

# Option A (default) — Microsoft 365, the SAME values as DaVision
# (Cloud Run service asca-vision). Store the client secret as a Secret.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
MAIL_FROM=

# Option B — SMTP2GO web API. If this is set it is used instead of Microsoft 365.
# MAIL_FROM must then be a sender verified in SMTP2GO.
# SMTP2GO_API_KEY=

MAIL_TO=mariob@ascaofficesolutions.com

# Local testing only: without email settings, log instead of sending.
# ALLOW_MOCK_EMAIL=true
