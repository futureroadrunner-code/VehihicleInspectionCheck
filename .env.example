# SMTP settings for /api/submit. When SMTP_HOST is unset the API runs in
# "mock" mode: it validates and logs the report but sends no email.
# Set real values in Netlify (Site configuration → Environment variables),
# never in this file: the repository is public.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# "true" only for SSL ports (465, 8465, 443). Leave unset for 2525/587 (STARTTLS).
SMTP_SECURE=
# Must be a sender address/domain verified in SMTP2GO.
MAIL_FROM="ASCA Vehicle Check <service@ascaofficesolutions.com>"
MAIL_TO=mariob@ascaofficesolutions.com
