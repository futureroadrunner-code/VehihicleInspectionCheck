# SMTP settings for /api/submit. When SMTP_HOST is unset the API runs in
# "mock" mode: it validates and logs the report but sends no email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for port 465 (implicit TLS); leave unset for STARTTLS on 587.
SMTP_SECURE=
MAIL_FROM="FleetCheck <fleetcheck@example.com>"
MAIL_TO=service@ascaofficesolutions.com
